[Unit]
Description=amperegen OpenAI-Compatible API Server (Qwen3.8-27B-FP8 + DFlash2 on Ampere sm_80)
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=amperegen
Group=amperegen
WorkingDirectory=/opt/amperegen

# Optional: set persistence mode and power cap (e.g. 210 W on CMP 170HX)
# ExecStartPre=+/usr/bin/nvidia-smi -pm 1
# ExecStartPre=+/usr/bin/nvidia-smi -pl 210

ExecStart=/opt/amperegen/build/amperegen \
  --model-path /path/to/models/Qwen3.8-27B-FP8 \
  --draft-path /path/to/models/Qwen3.8-27B-DFlash2 \
  --served-model-name Qwen3.8-27B-FP8 \
  --host 0.0.0.0 \
  --port 8000 \
  --context-length 200000 \
  --max-running-requests 16 \
  --chunked-prefill-size 8192 \
  --block-size 8 \
  --kv-pool-gb 18 \
  --python /opt/amperegen/.venv/bin/python \
  --sidecar-script /opt/amperegen/sidecar/app.py

Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60
LimitNOFILE=1048576
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
